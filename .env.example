# Copy to .env and fill in. Check with `repolens doctor`.

# Local Postgres from `docker compose up -d`
DATABASE_URL=postgresql://repolens:repolens@localhost:5432/repolens

# Required for the default chat model: Gemini free tier (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Required: embeddings, a few cents per repo (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional
# Chat model as provider:model, provider google or anthropic
# (default google:gemini-3.1-flash-lite)
CHAT_MODEL=
# Needed when CHAT_MODEL is anthropic:... (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Seconds to wait for one chat model request (default 120)
CHAT_TIMEOUT=
# Python file defining llm(name, timeout) for other providers
LOCAL_MODELS=
# Where each Run's JSONL log is written (default ~/.repolens/runs)
RUNS_DIR=
GITHUB_TOKEN=
