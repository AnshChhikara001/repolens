# Copy to .env and fill in. Check with `repolens doctor`.

# Local Postgres from `docker compose up -d`
DATABASE_URL=postgresql://repolens:repolens@localhost:5432/repolens

# Required: Gemini free tier (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Required: embeddings, a few cents per repo (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional
# Chat model as provider:model (default google_genai:gemini-3.5-flash)
CHAT_MODEL=
# Seconds to wait for one chat model request (default 120)
CHAT_TIMEOUT=
# Python file with extra chat models: PRICES and chat_model(name, timeout)
LOCAL_MODELS=
GROQ_API_KEY=
GITHUB_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
